1 ICON "../../assets/app/app.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "WhatsMySpeed Contributors"
      VALUE "FileDescription",  "WhatsMySpeed - Windows 11 Real-Time Internet Speed Monitor"
      VALUE "FileVersion",      "1.0.0.0"
      VALUE "InternalName",     "WhatsMySpeed"
      VALUE "LegalCopyright",   "MIT License"
      VALUE "OriginalFilename", "WhatsMySpeed.exe"
      VALUE "ProductName",      "WhatsMySpeed"
      VALUE "ProductVersion",   "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
